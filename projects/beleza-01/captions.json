[
  {
    "start": 0.6,
    "end": 2.356659574468085,
    "text": "Você compra máscara de cabelo"
  },
  {
    "start": 2.356659574468085,
    "end": 3.447,
    "text": "pelo nome no pote?"
  },
  {
    "start": 3.397,
    "end": 6.268567567567567,
    "text": "Hidratação, nutrição, reconstrução... parece que"
  },
  {
    "start": 6.268567567567567,
    "end": 7.824,
    "text": "cada uma mora num planeta."
  },
  {
    "start": 7.824,
    "end": 9.285,
    "text": "Mas vamos simplificar."
  },
  {
    "start": 9.285,
    "end": 11.438333333333333,
    "text": "Imagine três ajudantes cuidando do"
  },
  {
    "start": 11.438333333333333,
    "end": 12.135,
    "text": "seu cabelo."
  },
  {
    "start": 12.135,
    "end": 13.639660550458716,
    "text": "A hidratação chega com uma"
  },
  {
    "start": 13.639660550458716,
    "end": 15.89665137614679,
    "text": "gotinha: essas fórmulas costumam buscar"
  },
  {
    "start": 15.89665137614679,
    "end": 17.169825688073395,
    "text": "mais maciez e ajudar o"
  },
  {
    "start": 17.169825688073395,
    "end": 18.153642201834863,
    "text": "fio a lidar com a"
  },
  {
    "start": 18.153642201834863,
    "end": 18.443,
    "text": "água."
  },
  {
    "start": 18.443,
    "end": 19.89671428571429,
    "text": "A glicerina é um exemplo"
  },
  {
    "start": 19.89671428571429,
    "end": 21.411,
    "text": "de ingrediente umectante."
  },
  {
    "start": 21.411,
    "end": 23.1932,
    "text": "A nutrição aparece com óleos"
  },
  {
    "start": 23.1932,
    "end": 23.957,
    "text": "e manteigas."
  },
  {
    "start": 23.957,
    "end": 25.972775,
    "text": "Eles podem ajudar na lubrificação,"
  },
  {
    "start": 25.972775,
    "end": 27.277099999999997,
    "text": "no brilho e na redução"
  },
  {
    "start": 27.277099999999997,
    "end": 28.7,
    "text": "do atrito entre os fios."
  },
  {
    "start": 28.7,
    "end": 30.456785714285715,
    "text": "Mas quantidade e fórmula fazem"
  },
  {
    "start": 30.456785714285715,
    "end": 32.447809523809525,
    "text": "diferença: mais óleo não significa"
  },
  {
    "start": 32.447809523809525,
    "end": 33.619,
    "text": "um resultado melhor."
  },
  {
    "start": 33.619,
    "end": 35.557,
    "text": "Já a reconstrução costuma destacar"
  },
  {
    "start": 35.557,
    "end": 37.894,
    "text": "proteínas hidrolisadas, como a queratina."
  },
  {
    "start": 37.894,
    "end": 39.83378125,
    "text": "Dependendo da fórmula, elas podem"
  },
  {
    "start": 39.83378125,
    "end": 42.65528125,
    "text": "melhorar temporariamente algumas propriedades do"
  },
  {
    "start": 42.65528125,
    "end": 43.537,
    "text": "fio danificado."
  },
  {
    "start": 43.537,
    "end": 45.556971830985916,
    "text": "Não é uma restauração definitiva,"
  },
  {
    "start": 45.556971830985916,
    "end": 47.026042253521126,
    "text": "nem uma cola mágica para"
  },
  {
    "start": 47.026042253521126,
    "end": 47.883,
    "text": "pontas duplas."
  },
  {
    "start": 47.883,
    "end": 49.19606849315069,
    "text": "E aqui está o detalhe:"
  },
  {
    "start": 49.19606849315069,
    "end": 51.22535616438357,
    "text": "essas categorias podem se misturar"
  },
  {
    "start": 51.22535616438357,
    "end": 52.24,
    "text": "no mesmo produto."
  },
  {
    "start": 52.24,
    "end": 53.59465306122449,
    "text": "Não dá para escolher só"
  },
  {
    "start": 53.59465306122449,
    "end": 55.126,
    "text": "pela palavra da embalagem."
  },
  {
    "start": 55.126,
    "end": 56.31596296296296,
    "text": "Leia o modo de uso,"
  },
  {
    "start": 56.31596296296296,
    "end": 58.32011111111111,
    "text": "observe como seu cabelo responde"
  },
  {
    "start": 58.32011111111111,
    "end": 59.885851851851854,
    "text": "e evite montar uma rotina"
  },
  {
    "start": 59.885851851851854,
    "end": 61.89,
    "text": "cheia de etapas sem necessidade."
  },
  {
    "start": 61.89,
    "end": 63.66720754716982,
    "text": "Antes de comprar três potes,"
  },
  {
    "start": 63.66720754716982,
    "end": 65.00011320754717,
    "text": "entenda o que você já"
  },
  {
    "start": 65.00011320754717,
    "end": 65.254,
    "text": "tem."
  },
  {
    "start": 65.254,
    "end": 67.00078947368421,
    "text": "Salva este vídeo para a"
  },
  {
    "start": 67.00078947368421,
    "end": 68.14,
    "text": "próxima compra!"
  }
]